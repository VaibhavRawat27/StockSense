# StockSense Environment Configuration Example
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=supersecretstocksensejwtkey2026

# Google SMTP / App Password Configuration
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="StockSense Security <your-email@gmail.com>"
